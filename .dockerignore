# Environnement Python local
venv/
.venv/
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
.Python

# Secrets et réglages locaux : transmis au conteneur par Compose (env_file),
# jamais copiés dans l'image
.env
.env.*
!.env.example

# Logos téléchargés (lourds) : conservés hors de l'image et montés en volume.
# Le logo par défaut reste dans l'image.
static/logos/*
!static/logos/default.svg

# Core dumps d'un worker planté
core
core.[0-9]*

# Logs locaux
logs/
*.log

# Données temporaires et exports à la racine (data/*.csv reste dans l'image)
*.csv
dump.csv
temp_assets.csv
enriched_assets.csv

# Tests et outils de dev
tests/
scratch/
.pytest_cache/
.ruff_cache/
.coverage
coverage.json
coverage.xml
htmlcov/
node_modules/

# Git
.git/
.gitignore

# IDE
.vscode/
.idea/
*.swp
**/.DS_Store

# Docker
.dockerignore
docker-compose*.yml

# Données isin
data/isin_data/
