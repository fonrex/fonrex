# Environnement Python local
venv/
.venv/
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
.Python

# Secrets and local settings: passed to the container by Compose (env_file),
# never copied into the image
.env
.env.*
!.env.example

# Downloaded logos (heavy): kept out of the image and mounted as a volume.
# The default logo stays in the image.
static/logos/*
!static/logos/default.svg

# Core dumps of a crashed worker
core
core.[0-9]*

# Local logs
logs/
*.log

# Temporary data and exports at the root (data/*.csv stays in the image)
*.csv
dump.csv
temp_assets.csv
enriched_assets.csv

# Tests and dev tools
tests/
scratch/
.pytest_cache/
.ruff_cache/
.coverage
coverage.json
coverage.xml
htmlcov/
node_modules/

# Git
.git/
.gitignore

# IDE
.vscode/
.idea/
*.swp
**/.DS_Store

# Docker
.dockerignore
docker-compose*.yml

# ISIN data
data/isin_data/
