# Fonrex configuration
#
# Copy this file to `.env`. Docker Compose loads it into the API container
# (`env_file`), and `make run` loads it for a local run.
# Keep one `KEY=value` per line and put comments on their own lines: a comment
# placed after an empty value would be read as the value itself.

# ── Authentication ───────────────────────────────────────────────────────────
# The API requires a key by default: until one is configured, every route except
# /health, /docs and the OpenBB discovery files rejects the request.
# Generate one with:  echo "frx_live_$(openssl rand -hex 24)"
# Clients send it as `Authorization: Bearer <key>` or `X-API-KEY: <key>`.
FONREX_API_KEY=
# Optional: additional accepted keys, comma-separated.
FONREX_API_KEYS=
# Optional: read-only keys, comma-separated. They can query data but cannot clear
# the cache, clean the database, trigger ingestion or change subscriptions.
# Give one of these to any client that stores the key outside this machine
# (Google Sheets connector, dashboard reached through a tunnel).
FONREX_READ_ONLY_API_KEYS=
# Set to false ONLY for a local instance that is not reachable from any network:
# it opens every route, including cache and database administration.
# Ignored as soon as a key is configured above.
FONREX_AUTH_REQUIRED=true

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# 'localhost' is used here for direct local development (outside Docker).
# With Docker Compose, DATABASE_URL is overridden in docker-compose.yml (db:5432)
# and built from POSTGRES_PASSWORD.
DATABASE_URL=postgresql://fonrex:fonrex_password@localhost:5432/fonrex
POSTGRES_DB=fonrex
POSTGRES_USER=fonrex
# Change it before the first `docker compose up` and keep DATABASE_URL in sync.
# Use letters, digits, '-' and '_' only (the value is embedded in a URL).
# The password is stored in the database volume at initialisation: changing it
# later requires `ALTER USER fonrex PASSWORD '...'` or recreating the volume.
POSTGRES_PASSWORD=fonrex_password
# asyncpg URL (auto-inferred from DATABASE_URL if empty)
ASYNC_DATABASE_URL=

# ── Redis ────────────────────────────────────────────────────────────────────
# Overridden (redis:6379) with Docker Compose.
REDIS_URL=redis://localhost:6379/0

# Default cache time-to-live in Redis (seconds)
CACHE_TTL=300

# Phase 3 — Specialized Providers
# OpenFIGI: free without key (reduced rate limit) — free key at https://www.openfigi.com/api
OPENFIGI_API_KEY=

# SEC EDGAR: email is REQUIRED per SEC policy (anonymous bots are banned)
SEC_EDGAR_EMAIL=contact@fonrex.io

# ── Historical EOD Ingestion ─────────────────────────────────────────────────
# Bulk ingestion parallelism
INGEST_CONCURRENCY=5
# Delay between yfinance requests (seconds)
INGEST_YF_DELAY=0.5
# Delay between TradingView requests (seconds)
INGEST_TV_DELAY=2.0
# Upsert batch size
INGEST_BATCH_SIZE=1000

# ── Real-time Streaming (Phase 6) ────────────────────────────────────────────
# Maximum simultaneous connections to TradingView WebSocket
TV_MAX_CONNECTIONS=10
# Initial reconnection delay in seconds (exponential backoff)
TV_RECONNECT_DELAY=5
# Real-time cache time-to-live (TTL) in Redis (seconds)
REALTIME_QUOTE_TTL=60

# ── Technical Indicators (Trend, Momentum, Volatility, Volume) ───────────────
TECHNICAL_CACHE_ENABLED=true
# Bars loaded when a request gives no limit (10 to 5000)
TECHNICAL_DEFAULT_LIMIT=500
# Size limits of POST /technical/batch
TECHNICAL_MAX_BATCH_TICKERS=20
TECHNICAL_MAX_BATCH_INDICATORS=10

# ── Financial News — Multi-provider Aggregator (Phase 10) ────────────────────
# News Redis cache TTL (seconds)
NEWS_CACHE_TTL=1800
# Articles returned for a ticker when the request gives no limit
NEWS_DEFAULT_LIMIT=20
# Largest limit a request may ask for
NEWS_MAX_LIMIT=100
# Title similarity threshold for deduplication (0-1)
NEWS_DEDUP_SIMILARITY=0.85

# ── DCF Valuation (Phase 11) ─────────────────────────────────────────────────
# DCF Redis cache TTL (seconds, 6h)
DCF_CACHE_TTL=21600
# Default projection years (3 to 10)
DCF_DEFAULT_PROJECTION_YEARS=5
# Risk-free rate used when the source of the currency of the statements
# (FRED for USD, the ECB for EUR) gives none and none is stored, and for every
# other currency; as a ratio (0.04 = 4 %; it may be negative, between -0.1 and 0.5)
DCF_RISK_FREE_RATE=0.04
# Equity risk premium, as a ratio (0.055 = 5.5 %)
DCF_EQUITY_RISK_PREMIUM=0.055
# Default terminal growth rate, as a ratio (0.025 = 2.5 %)
DCF_TERMINAL_GROWTH_RATE=0.025

# ── Macro Rates & FRED (Phase 13) ────────────────────────────────────────────
# Optional: Free API key at fred.stlouisfed.org
FRED_API_KEY=
# Macro rates cache TTL (seconds, 6h), for FRED and the ECB
MACRO_RATES_CACHE_TTL=21600
# ECB Data Portal (euro area rates): free, no key. Set only to use a mirror.
# ECB_API_URL=https://data-api.ecb.europa.eu/service/data
# ECB reference exchange rates of the euro: a currency read less than this many
# hours ago is not asked again (1 to 720)
FX_RATES_REFRESH_HOURS=12

# ── Factor returns (Kenneth French Data Library) ────────────────────────────
# A factor file read less than this many days ago is not downloaded again
# (1 to 90). The library is updated about once a month.
FACTORS_REFRESH_DAYS=7
# Kenneth French Data Library: free, no key. Set only to use a mirror.
# FRENCH_LIBRARY_URL=https://mba.tuck.dartmouth.edu/pages/faculty/ken.french/ftp

# ── Provider Monitoring (Phase 12) ───────────────────────────────────────────
# Consensus deviation threshold (50%)
VALIDATION_OUTLIER_THRESHOLD=0.50
# Minimum providers for consensus
VALIDATION_MIN_PROVIDERS=2
# UTC hour of the daily canary
CANARY_RUN_HOUR=6
# Canary parallelism
CANARY_PROVIDER_SEMAPHORE=3
# Validity of a dynamic range (6 h)
CANARY_PRICE_RANGE_TTL_SECONDS=21600
# Retry after a failure (5 min)
CANARY_PRICE_RANGE_NEGATIVE_TTL_SECONDS=300
# Canary failures -> critical alert
ALERT_CANARY_CRITICAL=3
# Success rate -> critical alert
ALERT_SUCCESS_RATE_CRITICAL=0.70
# Success rate -> warning alert
ALERT_SUCCESS_RATE_WARNING=0.85

# ── Usage log ────────────────────────────────────────────────────────────────
# Each API call is recorded in the usage_logs table of your instance, after the
# response has been sent.
# What is kept of the caller's IP address: none, truncated (network only) or full.
USAGE_LOG_IP=none
# Days of usage log kept; older rows are deleted once a day. 0 keeps everything.
USAGE_LOG_RETENTION_DAYS=90

# ── "Batteries included" mode ────────────────────────────────────────────────
# If true, runs the initial data import (ETFs) on first API startup.
SEED_ON_FIRST_RUN=false

# Import Assets from img.logo.dev
LOGO_TOKEN=

# ── Outbound requests of the providers ───────────────────────────────────────
# Requests one provider may run at the same time (1 to 64). Keeps a burst of API
# calls from hammering a single website.
FONREX_PROVIDER_MAX_CONCURRENCY=4
# Optional outbound HTTP proxy for the providers (your own proxy or a relay
# service), e.g. http://user:password@host:8888. Empty: direct connection.
# It applies to the scraped websites, not to the yfinance or TradingView libraries.
FONREX_PROXY_URL=
# Optional: only these providers use the proxy, the others stay direct.
# Comma-separated names as listed by GET /health/providers (case-insensitive),
# e.g. Investing,Gurufocus,wallStreetJournal. Empty: every provider uses it.
FONREX_PROXY_PROVIDERS=

# Financial Providers
BARRONS_TOKEN=
MARKETWATCH_TOKEN=
WSJ_TOKEN=

# OpenBB Workspace Integration
OPENBB_ALLOWED_ORIGIN=https://pro.openbb.co
