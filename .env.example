# PostgreSQL Configuration
# Note: 'localhost' is used here for direct local development (outside Docker).
# If you use Docker Compose, these URLs are automatically overridden in docker-compose.yml (db:5432).
DATABASE_URL=postgresql://fonrex:fonrex_password@localhost:5432/fonrex
POSTGRES_DB=fonrex
POSTGRES_USER=fonrex
POSTGRES_PASSWORD=fonrex_password

# Redis Configuration
# Note: Same, automatically overridden (redis:6379) with Docker Compose.
REDIS_URL=redis://localhost:6379/0

# Flask Configuration
FLASK_ENV=production
SECRET_KEY=your-secret-key-change-in-production
CACHE_TTL=300

# Testing Configuration
TEST_DATABASE_URL=postgresql://fonrex:fonrex_password@localhost:5432/fonrex_test

# Phase 3 — Specialized Providers
# OpenFIGI: free without key (reduced rate limit) — free key at https://www.openfigi.com/api
OPENFIGI_API_KEY=

# SEC EDGAR: email is REQUIRED per SEC policy (anonymous bots are banned)
# Expected format: "CompanyName email@domain.com"
SEC_EDGAR_EMAIL=contact@fonrex.io

# Historical EOD Ingestion
INGEST_CONCURRENCY=5         # Bulk ingestion parallelism
INGEST_YF_DELAY=0.5          # Delay between yfinance requests (seconds)
INGEST_TV_DELAY=2.0          # Delay between TradingView requests (seconds)
INGEST_BATCH_SIZE=1000       # Upsert batch size

# Real-time Streaming (Phase 6)
TV_MAX_CONNECTIONS=10        # Maximum simultaneous connections to TradingView WebSocket
TV_RECONNECT_DELAY=5        # Initial reconnection delay in seconds (exponential backoff)
REALTIME_QUOTE_TTL=60        # Real-time cache time-to-live (TTL) in Redis (seconds)
REALTIME_AUTO_SUBSCRIBE=true  # If true, accessing /quote/{ticker} automatically subscribes to streaming

# Technical Indicators (Trend, Momentum, Volatility, Volume)
TECHNICAL_CACHE_ENABLED=true
TECHNICAL_DEFAULT_LIMIT=500
TECHNICAL_MAX_BATCH_TICKERS=20
TECHNICAL_MAX_BATCH_INDICATORS=10

# Financial News — Multi-provider Aggregator (Phase 10)
NEWS_CACHE_TTL=1800           # News Redis cache TTL (seconds)
NEWS_DEFAULT_LIMIT=20         # Default number of articles
NEWS_MAX_LIMIT=100            # Maximum limit per request
NEWS_PROVIDERS_TIMEOUT=10     # Global provider timeout (seconds)
NEWS_DEDUP_SIMILARITY=0.85    # Title similarity threshold for deduplication (0-1)

# DCF Valuation (Phase 11)
DCF_CACHE_TTL=21600              # DCF Redis cache TTL (seconds, 6h)
DCF_DEFAULT_PROJECTION_YEARS=5   # Default projection years
DCF_RISK_FREE_RATE=0.04          # Risk-free rate (US 10Y Treasury)
DCF_EQUITY_RISK_PREMIUM=0.055    # Equity risk premium
DCF_TERMINAL_GROWTH_RATE=0.025   # Default terminal growth rate

# Provider Monitoring (Phase 12)
VALIDATION_OUTLIER_THRESHOLD=0.50   # Consensus deviation threshold (50%)
VALIDATION_MIN_PROVIDERS=2          # Minimum providers for consensus
CANARY_RUN_HOUR=6                   # UTC hour of the daily canary
CANARY_PROVIDER_SEMAPHORE=3         # Canary parallelism
CANARY_PRICE_RANGE_TTL_SECONDS=21600 # Validity of a dynamic range (6 h)
CANARY_PRICE_RANGE_NEGATIVE_TTL_SECONDS=300 # Retry after a failure (5 min)
ALERT_CANARY_CRITICAL=3             # Canary failures -> critical alert
ALERT_SUCCESS_RATE_CRITICAL=0.70    # Success rate -> critical alert
ALERT_SUCCESS_RATE_WARNING=0.85     # Success rate -> warning alert
ASYNC_DATABASE_URL=                 # asyncpg URL (auto-inferred from DATABASE_URL if empty)

# "Batteries included" mode
# If true, runs the initial data import (ETFs) on first API startup.
SEED_ON_FIRST_RUN=false

# Import Assets from img.logo.dev
LOGO_TOKEN=

# Financial Providers
BARRONS_TOKEN=
MARKETWATCH_TOKEN=
WSJ_TOKEN=
